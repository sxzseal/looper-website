---
// Changelog 时间线
const versions = [
  {
    tag: 'v0.4.6',
    date: '当前版本',
    title: '让桌面端工作流形成闭环',
    highlights: [
      '对话、工作流库、画布与运行看板',
      '本地 Pi Agent runtime 与模型服务配置',
      'Skill 管理与工作流草稿确认发布',
      '工作空间与任务产物管理',
    ],
    latest: true,
  },
  {
    tag: 'WORKFLOW',
    date: '流程能力',
    title: '把自动化变成可编辑的流程',
    highlights: [
      '节点、依赖、并行与循环编排',
      '导入导出与可移植工作流格式',
      '运行状态、输出与重试记录',
    ],
  },
  {
    tag: 'CONTROL',
    date: '执行边界',
    title: '让 Agent 的操作保持可控',
    highlights: [
      '请求批准与完全访问两种权限模式',
      '高副作用工作流运行前二次确认',
    ],
  },
];
---

<section id="changelog" class="relative py-32 px-4">
  <div class="mx-auto max-w-4xl">
    <div class="text-center mb-16">
      <p class="section-eyebrow reveal">版本记录</p>
      <h2 class="reveal text-4xl md:text-5xl font-bold tracking-tight text-gradient">
        已经可以用 Looper 做什么
      </h2>
    </div>

    <!-- 时间线 -->
    <div class="stagger relative">
      <ol class="space-y-10">
        {versions.map((v) => (
          <li class="relative">

            <div class="glass p-6 hover:border-white/20 transition-colors">
              <div class="flex items-baseline gap-3 mb-2 flex-wrap">
                <span class="font-mono text-lg font-semibold text-gradient">{v.tag}</span>
                {v.latest && (
                  <span class="px-2 py-0.5 rounded-full bg-aurora-violet/20 border border-aurora-violet/40 text-aurora-violet text-[10px] font-medium">
                    CURRENT
                  </span>
                )}
                <span class="text-xs text-white/30 font-mono ml-auto">{v.date}</span>
              </div>
              <h3 class="text-lg font-medium mb-3">{v.title}</h3>
              <ul class="space-y-1.5">
                {v.highlights.map((h) => (
                  <li class="flex items-start gap-2 text-sm text-white/60">
                    <span class="change-bullet" aria-hidden="true"></span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
