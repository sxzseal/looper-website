---
// Changelog 时间线
const versions = [
  {
    tag: 'v0.1.0',
    date: '2026-07-20',
    title: '首个可下载测试版',
    highlights: [
      'DAG 画布编辑器 (xyflow)',
      'agent / claudecode / loop 三类执行器',
      '本地 Claude Code CLI 集成',
      'Skill 发现与工作流库',
    ],
    latest: true,
  },
  {
    tag: 'v0.0.9',
    date: '2026-07-08',
    title: '内部预览',
    highlights: [
      '聊天式触发原型',
      'MCP 服务器接入',
      'IPC 通道稳定',
    ],
  },
  {
    tag: 'v0.0.7',
    date: '2026-06-18',
    title: '首次跑通端到端',
    highlights: [
      'Electron shell + Next.js 静态导出',
      'DAG 校验器',
    ],
  },
];
---

<section id="changelog" class="relative py-32 px-4">
  <div class="mx-auto max-w-4xl">
    <div class="text-center mb-16">
      <div class="reveal inline-flex items-center gap-2 px-3 py-1 mb-4 rounded-full glass text-xs text-white/60">
        <span class="w-1 h-1 rounded-full bg-aurora-amber"></span>
        版本记录
      </div>
      <h2 class="reveal text-4xl md:text-5xl font-bold tracking-tight text-gradient">
        每一次迭代都在进化
      </h2>
    </div>

    <!-- 时间线 -->
    <div class="stagger relative">
      <!-- 垂直连线 -->
      <div class="absolute left-4 top-2 bottom-2 w-px bg-gradient-to-b from-aurora-violet/50 via-white/10 to-transparent"></div>

      <ol class="space-y-10">
        {versions.map((v) => (
          <li class="relative pl-14">
            <!-- 节点 -->
            <div class={`absolute left-0 top-1.5 w-9 h-9 rounded-full flex items-center justify-center ${v.latest ? 'bg-gradient-to-br from-aurora-violet to-aurora-cyan' : 'glass'}`}>
              <div class={`w-3 h-3 rounded-full ${v.latest ? 'bg-white' : 'bg-white/40'} ${v.latest ? 'animate-pulse' : ''}`}></div>
            </div>

            <div class="glass p-6 hover:border-white/20 transition-colors">
              <div class="flex items-baseline gap-3 mb-2 flex-wrap">
                <span class="font-mono text-lg font-semibold text-gradient">{v.tag}</span>
                {v.latest && (
                  <span class="px-2 py-0.5 rounded-full bg-aurora-violet/20 border border-aurora-violet/40 text-aurora-violet text-[10px] font-medium">
                    LATEST
                  </span>
                )}
                <span class="text-xs text-white/30 font-mono ml-auto">{v.date}</span>
              </div>
              <h3 class="text-lg font-medium mb-3">{v.title}</h3>
              <ul class="space-y-1.5">
                {v.highlights.map((h) => (
                  <li class="flex items-start gap-2 text-sm text-white/60">
                    <span class="text-aurora-cyan/70 mt-1.5">→</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
