---
import { releases } from '../data/product';
---

<section id="changelog" class="section changelog-section">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">持续更新</p>
        <h2>最近更新。</h2>
      </div>
      <p>来自 Looper 项目的真实更新记录。</p>
    </div>
    <div class="release-list">
      {releases.map((r) => (
        <article class="release-entry" data-reveal>
          <div class="release-meta">
            <span class="release-version">v{r.version}</span>
            <time datetime={r.date}>{r.date}</time>
            {r.label && <span class="release-label">{r.label}</span>}
          </div>
          <div>
            <h3>{r.title}</h3>
            <ul>
              {r.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
