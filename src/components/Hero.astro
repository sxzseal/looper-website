---
import ProductImage from './ProductImage.astro';
import { screenshots } from '../data/product-images';
---

<section id="top" class="hero">
  <div class="hero-orbit" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="shell hero-inner">
    <div class="hero-copy">
      <div class="hero-title">
        <p class="eyebrow hero-eyebrow">想法与结果之间，有 Looper。</p>
        <h1>
          把想法，
          <br />
          <span>推进成结果。</span>
        </h1>
      </div>
      <div class="hero-aside">
        <p class="hero-description">
          你的本地 AI 工作空间。
          <br />
          从一句交办，到文件、浏览器与工具的协作。让工作向前，让好流程留下来。
        </p>
        <div class="hero-actions">
          <a href="#download" class="button button-primary">
            下载 Looper
          </a>
          <a href="#showcase" class="button button-secondary">
            <span class="play-icon" aria-hidden="true"></span>探索工作方式
          </a>
        </div>
        <p class="hero-platforms">
          macOS / Windows <span>模型由你选择</span>
        </p>
      </div>
    </div>
    <div class="hero-product">
      <div class="hero-product-label">
        <span>Looper / 本地 AI 工作空间</span>
        <span>对话与文档，并排向前。</span>
      </div>
      <ProductImage
        screenshot={screenshots.workspace}
        eager
        caption="对话、材料与结果，在同一处继续。"
      />
    </div>
    <div class="hero-principles" aria-label="Looper 工作方式">
      <p>
        <span>从目标开始</span>用自然语言交办
      </p>
      <p>
        <span>连接真实工作</span>文件、浏览器与终端
      </p>
      <p>
        <span>沉淀有效步骤</span>把流程留给下一次
      </p>
    </div>
  </div>
</section>
