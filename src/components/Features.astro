---
import { features } from '../data/product';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = [
  'M6 3v12a3 3 0 0 0 3 3h9M6 9h9a3 3 0 0 0 3-3V3M3 3h6m6 0h6m-6 15 3 3 3-3',
  'M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Zm-4 9 3 3 5-6',
  'M14 3H5v18h14V8l-5-5Zm0 0v5h5M8 12h8m-8 4h5',
  'M9 3H4v5m16 0V3h-5M4 16v5h5m6 0h5v-5M8 12h8m-4-4v8',
];
const details = [
  ['对话起草', '画布调整', '保存复用'],
  ['权限设置', '执行记录'],
  ['文档', '表格', '项目文件'],
  ['模型服务', '自定义 Skill'],
];
const steps = [
  {
    name: '读取参考材料',
    description: '带上文件与项目上下文',
    kind: '文件',
    path: 'M3 7h7l2 2h9v11H3V7Zm0 0V4h7l2 3',
  },
  {
    name: '连接工具，推进任务',
    description: '浏览器、终端与技能协作',
    kind: '工具',
    path: 'm4 7 5 5-5 5m9 0h7',
  },
  {
    name: '整理结果，留在工作空间',
    description: '查看交付物，接着处理',
    kind: '交付',
    path: 'M14 3H5v18h14V8l-5-5Zm0 0v5h5M8 12h8m-8 4h5',
  },
];
---

<section id="features" class="section features-section">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">为真正的工作而生</p>
        <h2>
          不止想到。
          <br />
          <span class="muted-heading">更能做到。</span>
        </h2>
      </div>
      <div class="capability-heading-aside">
        <p>
          目标、工具与工作方法，
          <br />
          在同一个桌面工作空间里相遇。
        </p>
        <a href="#showcase">看看实际工作场景</a>
      </div>
    </div>

    <div class="capability-stage" data-reveal>
      <article class="goal-panel">
        <p class="capability-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linejoin="round"
            />
          </svg>
          自然语言交办
        </p>
        <h3>{features[0].name}</h3>
        <p class="capability-description">{features[0].text}</p>
        <div class="goal-demo">
          <div class="goal-demo-heading">
            <span>你的目标</span>
            <span>任务示意</span>
          </div>
          <div class="goal-message">
            <img
              src={`${base}/logo-mark.svg`}
              width="34"
              height="34"
              alt="Looper"
            />
            <p>
              整理这些资料，
              <br />
              写一份有来源、有结论的调研报告。
            </p>
          </div>
          <div class="goal-context" aria-label="随任务提供的上下文">
            <span>
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="m9 12 5-5a3 3 0 0 1 4 4l-7 7a5 5 0 0 1-7-7l7-7"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
              参考资料
            </span>
            <span>项目上下文</span>
          </div>
          <p class="goal-demo-note">
            说清想完成什么，把相关材料一起交给 Looper。
          </p>
        </div>
      </article>

      <span class="capability-bridge" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12h14m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </span>

      <article class="execution-panel">
        <p class="capability-label">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="m4 7 5 5-5 5m9 0h7"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          本地工具协作
        </p>
        <h3>{features[1].name}</h3>
        <p class="capability-description">{features[1].text}</p>
        <div class="execution-demo">
          <div class="execution-demo-heading">
            <span class="mono">looper / workspace</span>
            <span>过程示意</span>
          </div>
          <ol class="execution-steps">
            {steps.map((step, i) => (
              <li style={{ '--step': i }}>
                <span class="execution-step-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path
                      d={step.path}
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <div>
                  <strong>{step.name}</strong>
                  <p>{step.description}</p>
                </div>
                <span class="execution-kind">{step.kind}</span>
              </li>
            ))}
          </ol>
        </div>
      </article>
    </div>

    <div class="capability-essentials">
      {features.slice(2).map((feature, i) => (
        <article
          class="capability-item"
          data-reveal
          style={{ '--order': i % 2 }}
        >
          <span class="capability-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <path
                d={paths[i]}
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <h3>{feature.name}</h3>
          <p>{feature.text}</p>
          <div class="capability-tags" aria-hidden="true">
            {details[i].map((detail) => (
              <span>{detail}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
