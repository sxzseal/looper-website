---
import { features } from '../data/product';

const symbols = ['✦', '>_', '⑂', '◎', '▤', '⌘'];
---

<section id="features" class="section features-section">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">产品能力</p>
        <h2>日常工作需要的能力。</h2>
      </div>
      <p>
        一个桌面工作空间，
        <br />
        装下你的目标、工具与工作方法。
      </p>
    </div>
    <div class="feature-grid">
      {features.map((f, i) => (
        <article class="feature-item" data-reveal style={{ '--order': i % 3 }}>
          <span class="feature-icon" aria-hidden="true">
            {symbols[i]}
          </span>
          <h3>{f.name}</h3>
          <p>{f.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
