---
import ProductImage from './ProductImage.astro';
import { screenshots } from '../data/product-images';

const scenarios = [
  {
    id: 'research',
    label: '资料调研',
    summary: '从参考材料，到清晰结论',
    title: '把零散资料，整理成清晰结论。',
    description:
      '带上问题与参考材料，整理信息、对比方案。结论、来源与文件留在同一个工作空间，方便继续推进。',
    screenshot: screenshots.research,
    detail: '资料整理、方案对比与下一步建议',
    icon: 'M10 3H4v18h16V9l-6-6Zm4 0v6h6M8 13h8m-8 4h5',
  },
  {
    id: 'project',
    label: '项目协作',
    summary: '让对话、代码与文件相连',
    title: '讨论到哪一步，项目就向前一步。',
    description:
      '围绕同一个项目讨论问题，并排查看代码与文件。结合终端与工具执行，让上下文接得上，改动有据可查。',
    screenshot: screenshots.project,
    detail: '对照任务讨论，直接预览项目代码',
    icon: 'm8 7-5 5 5 5m8-10 5 5-5 5m-3-13-2 16',
  },
  {
    id: 'workflow',
    label: '流程复用',
    summary: '这次有效的步骤，下次接着用',
    title: '把做对的步骤，留给下一次。',
    description:
      '先在对话中起草，再到画布调整节点、依赖与并行关系。确认后保存到工作流库，让重复的工作有熟悉的路径。',
    screenshot: screenshots.workflow,
    detail: '编辑节点提示词与工作流依赖关系',
    icon: 'M6 3v12a3 3 0 0 0 3 3h9M6 9h9a3 3 0 0 0 3-3V3M3 3h6m6 0h6m-6 15 3 3 3-3',
  },
];
---

<section id="showcase" class="section showcase-section">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">把可能，变成日常</p>
        <h2>
          你的下一件事，
          <br />
          <span class="muted-heading">从这里开始。</span>
        </h2>
      </div>
      <p>
        选一件熟悉的工作，
        <br />
        看看 Looper 如何把目标接到实际行动。
      </p>
    </div>

    <div class="showcase-tabs" role="tablist" aria-label="工作场景">
      {scenarios.map((scenario, i) => (
        <button
          id={`tab-${scenario.id}`}
          role="tab"
          aria-label={scenario.label}
          aria-describedby={`scenario-hint-${scenario.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${scenario.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={scenario.id}
        >
          <span class="showcase-choice-icon" aria-hidden="true">
            <svg width="23" height="23" viewBox="0 0 24 24" fill="none">
              <path
                d={scenario.icon}
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </span>
          <span class="showcase-choice-copy">
            <strong>{scenario.label}</strong>
            <span id={`scenario-hint-${scenario.id}`}>{scenario.summary}</span>
          </span>
        </button>
      ))}
    </div>

    {scenarios.map((scenario, i) => (
      <div
        class="scenario-panel"
        id={`panel-${scenario.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${scenario.id}`}
        hidden={i !== 0}
        tabindex="0"
      >
        <div class="scenario-overview">
          <div class="scenario-copy">
            <h3>{scenario.title}</h3>
            <p>{scenario.description}</p>
          </div>
          <a href="#download" class="scenario-action">
            用 Looper 开始
          </a>
        </div>
        <div class="scenario-media">
          <ProductImage
            screenshot={scenario.screenshot}
            caption={scenario.detail}
            sizes="(max-width: 760px) calc(100vw - 76px), (max-width: 1280px) calc(100vw - 152px), 1128px"
          />
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-tab]'),
  );
  function activate(tab: HTMLButtonElement) {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(`panel-${item.dataset.tab}`);
      if (panel) panel.hidden = !selected;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (event) => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft')
        next = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault();
      activate(tabs[next]);
      tabs[next].focus();
    });
  });
</script>
