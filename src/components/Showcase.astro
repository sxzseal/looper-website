---
const scenarios = [
  {
    id: 'research',
    label: '资料调研',
    title: '信息很多，先理出头绪。',
    description:
      '带上问题与参考材料，让 Agent 检索、整理和比对信息，再将结论写成文档。来源与交付文件放在同一个工作空间，方便回看。',
    prompt: '整理这些资料，对比不同方案，写一份带来源的调研报告。',
    steps: ['读取参考材料', '检索与交叉比对', '整理报告与来源'],
    output: '调研报告.docx',
    type: 'DOC',
    detail: '从收集到成稿，在同一处完成',
  },
  {
    id: 'project',
    label: '项目协作',
    title: '把项目上下文，变成行动。',
    description:
      '在本地项目中读取代码、调用终端，逐步完成修改与检查。运行记录保留工具调用与结果，便于复核和继续推进。',
    prompt: '检查这个项目的登录流程，定位问题，完成修复并验证。',
    steps: ['理解项目与定位问题', '修改代码与运行检查', '汇总改动和验证结果'],
    output: '改动与验证记录',
    type: 'DEV',
    detail: '文件、终端与任务上下文相连',
  },
  {
    id: 'workflow',
    label: '流程复用',
    title: '这次做对，下次接着用。',
    description:
      '在对话里把任务起草为工作流，再到画布调整节点、依赖、并行与循环。确认后保存，让反复发生的工作有一条熟悉的路径。',
    prompt: '把代码审查整理成工作流，分别检查逻辑、质量、安全和规范。',
    steps: ['在会话中起草工作流', '在画布上调整与确认', '保存到工作流库'],
    output: '代码审查工作流',
    type: 'FLOW',
    detail: '一次梳理，沉淀自己的工作方法',
  },
];
---

<section id="showcase" class="section showcase-section">
  <div class="shell">
    <div class="section-heading" data-reveal>
      <div>
        <p class="eyebrow">工作方式</p>
        <h2>从一件具体的事开始。</h2>
      </div>
      <p>
        在同一个工作空间里整理资料、推进项目，
        <br />
        把重复做的事变成可复用的流程。
      </p>
    </div>
    <div class="showcase-tabs" role="tablist" aria-label="工作场景">
      {scenarios.map((s, i) => (
        <button
          id={`tab-${s.id}`}
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${s.id}`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={s.id}
        >
          {s.label}
        </button>
      ))}
    </div>
    {scenarios.map((s, i) => (
      <div
        class="scenario-panel"
        id={`panel-${s.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${s.id}`}
        hidden={i !== 0}
        tabindex="0"
      >
        <div class="scenario-copy">
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <a href="#download" class="text-link">
            用 Looper 开始 <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="task-demo">
          <div class="demo-topbar">
            <span aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <span>looper / 工作空间</span>
            <span class="demo-label">场景示意</span>
          </div>
          <div class="demo-body">
            <div class="demo-user">
              <span>你</span>
              <p>{s.prompt}</p>
            </div>
            <div class="demo-agent">
              <img src="/logo-mark.svg" width="25" height="25" alt="Looper" />
              <span>让我们一步步完成。</span>
            </div>
            <ol class="demo-steps">
              {s.steps.map((step) => (
                <li>
                  <span>✓</span>
                  {step}
                </li>
              ))}
            </ol>
            <div class="demo-output">
              <span class="output-icon mono">{s.type}</span>
              <div>
                <strong>{s.output}</strong>
                <small>{s.detail}</small>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-tab]'),
  );
  function activate(tab: HTMLButtonElement) {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(`panel-${item.dataset.tab}`);
      if (panel) panel.hidden = !selected;
    });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab));
    tab.addEventListener('keydown', (e) => {
      let next = index;
      if (e.key === 'ArrowRight') next = (index + 1) % tabs.length;
      else if (e.key === 'ArrowLeft')
        next = (index - 1 + tabs.length) % tabs.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = tabs.length - 1;
      else return;
      e.preventDefault();
      activate(tabs[next]);
      tabs[next].focus();
    });
  });
</script>
