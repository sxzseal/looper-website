---
// 顶部固定导航栏
---

<header class="site-header fixed inset-x-0 top-0 z-50 h-[64px]">
  <div class="mx-auto flex h-full w-full max-w-7xl items-center px-5 sm:px-8">
    <nav class="site-header-nav relative flex w-full items-center justify-between gap-4" aria-label="主导航">
      <a href="#" class="site-brand group flex shrink-0 items-center gap-2.5" aria-label="Looper 首页">
        <span class="site-brand-mark">
          <img
            src="/logo.png"
            alt=""
            width="32"
            height="32"
            class="h-7 w-7 object-contain invert transition-transform duration-300 group-hover:scale-105 sm:h-8 sm:w-8"
          />
        </span>
        <span class="text-sm font-semibold tracking-tight text-white">Looper</span>
      </a>

      <ul class="site-nav-menu absolute left-1/2 hidden -translate-x-1/2 items-center gap-2 text-sm text-white/60 md:flex">
        <li><a href="#features" class="site-nav-link">功能</a></li>
        <li><a href="#showcase" class="site-nav-link">场景</a></li>
        <li><a href="#changelog" class="site-nav-link">更新</a></li>
        <li><a href="#faq" class="site-nav-link">FAQ</a></li>
      </ul>

      <a
        href="#download"
        class="site-download inline-flex shrink-0 items-center gap-1.5 rounded-lg px-3.5 py-2 text-sm font-semibold text-ink-950 transition-all duration-300 sm:px-4"
      >
        下载 Looper
      </a>
    </nav>
  </div>
</header>
