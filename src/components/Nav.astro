<header class="site-header">
  <nav class="shell nav-inner" aria-label="主导航">
    <a class="brand" href="#top" aria-label="Looper 首页">
      <img src="/logo-mark.svg" width="32" height="32" alt="" />
      <span>Looper</span>
    </a>
    <div class="nav-links">
      <a href="#features">产品能力</a>
      <a href="#showcase">工作方式</a>
      <a href="#changelog">更新日志</a>
    </div>
    <a class="nav-download" href="#download">
      下载 Looper <span aria-hidden="true">↗</span>
    </a>
    <button
      class="menu-toggle"
      aria-label="展开导航"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span></span>
      <span></span>
    </button>
    <div class="mobile-nav" id="mobile-nav" hidden>
      <a href="#features">产品能力</a>
      <a href="#showcase">工作方式</a>
      <a href="#changelog">更新日志</a>
      <a href="#faq">常见问题</a>
      <a href="#download">下载 Looper</a>
    </div>
  </nav>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.querySelector<HTMLElement>('.mobile-nav');
  if (toggle && menu) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '展开导航');
      menu.hidden = true;
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '收起导航' : '展开导航');
      menu.hidden = !open;
    });
    menu
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || menu.hidden) return;
      if (menu.contains(document.activeElement)) toggle.focus();
      close();
    });
    window.matchMedia('(min-width: 761px)').addEventListener('change', (e) => {
      if (e.matches) close();
    });
  }
</script>
