---
// 顶部固定导航栏
---

<header class="fixed top-0 inset-x-0 z-50 pt-4">
  <div class="mx-auto max-w-6xl px-4">
    <nav class="glass flex items-center justify-between px-4 py-2.5">
      <a href="#" class="flex items-center gap-2 group">
        <div class="relative w-8 h-8 rounded-lg bg-gradient-to-br from-aurora-violet to-aurora-cyan flex items-center justify-center">
          <span class="text-white font-bold text-sm">🔁</span>
          <div class="absolute inset-0 rounded-lg bg-gradient-to-br from-aurora-violet to-aurora-cyan blur-md opacity-50 group-hover:opacity-80 transition-opacity -z-10"></div>
