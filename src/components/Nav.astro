---
// 顶部固定导航栏
---

<header class="fixed top-0 inset-x-0 z-50 pt-4">
  <div class="mx-auto max-w-6xl px-4">
    <nav class="glass flex items-center justify-between px-4 py-2.5">
      <a href="#" class="flex items-center gap-2.5 group">
        <img
          src="/logo.png"
          alt="Looper"
          width="32"
          height="32"
          class="w-8 h-8 object-contain invert transition-transform group-hover:scale-105"
        />
        <span class="font-semibold tracking-tight">Looper</span>
      </a>

      <ul class="hidden md:flex items-center gap-7 text-sm text-white/70">
        <li><a href="#features" class="hover:text-white transition-colors">功能</a></li>
        <li><a href="#showcase" class="hover:text-white transition-colors">场景</a></li>
        <li><a href="#changelog" class="hover:text-white transition-colors">更新</a></li>
        <li><a href="#faq" class="hover:text-white transition-colors">FAQ</a></li>
      </ul>

      <a
        href="#download"
        class="inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg bg-white text-ink-950 text-sm font-medium hover:bg-white/90 transition-colors"
      >
        下载
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      </a>
    </nav>
  </div>
</header>
