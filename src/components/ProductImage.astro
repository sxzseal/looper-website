---
import type { ProductScreenshot } from '../data/product-images';
interface Props {
  screenshot: ProductScreenshot;
  caption?: string;
  eager?: boolean;
  sizes?: string;
  class?: string;
}
const {
  screenshot,
  caption,
  eager = false,
  sizes,
  class: className,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageRoot = `${base}/images/product/${screenshot.name}`;
---

<figure class:list={['product-image', className]}>
  <a
    class="product-image-link"
    href={`${imageRoot}-2240.webp`}
    target="_blank"
    rel="noopener"
    aria-label={`放大查看${screenshot.title}`}
    data-image-preview
    data-image-title={screenshot.title}
    data-image-alt={screenshot.alt}
    data-image-width={screenshot.width}
    data-image-height={screenshot.height}
  >
    <img
      src={`${imageRoot}-1680.webp`}
      srcset={`${imageRoot}-960.webp 960w, ${imageRoot}-1680.webp 1680w, ${imageRoot}-2240.webp 2240w`}
      sizes={
        sizes ??
        (eager
          ? '(max-width: 760px) calc(100vw - 52px), (max-width: 1280px) calc(100vw - 112px), 1164px'
          : '(max-width: 760px) calc(100vw - 40px), 720px')
      }
      width={screenshot.width}
      height={screenshot.height}
      alt={screenshot.alt}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
    />
    <span class="image-zoom" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
        <path
          d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      放大查看
    </span>
  </a>
  <figcaption>
    <span>{caption ?? screenshot.title}</span>
    <span>界面实拍 · 演示环境</span>
  </figcaption>
</figure>
