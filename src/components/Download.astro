---
import downloads from '../data/downloads.json';
const platforms = [
  { target: 'darwin-arm64', name: 'macOS', arch: 'Apple Silicon', symbol: '⌘' },
  { target: 'win32-x64', name: 'Windows', arch: 'x64', symbol: '⊞' },
  { target: 'darwin-x64', name: 'macOS', arch: 'Intel', symbol: '⌘' },
] as const;
---

<section id="download" class="section download-section">
  <div class="shell download-inner">
    <div class="download-heading" data-reveal>
      <p class="eyebrow">开始使用</p>
      <h2>下载 Looper，开始下一件事。</h2>
      <p class="download-intro">下载桌面应用，配置你的模型，带上一个目标。</p>
      <p class="download-note">
        安装包版本随各平台稳定通道更新。开发进展见
        <a href="#changelog">更新日志</a>。<br />
        使用前需配置模型服务，调用费用以服务商为准。
      </p>
    </div>
    <div class="download-picker">
      <div class="download-recommendation" data-download-recommendation hidden>
        <p>推荐安装包</p>
      </div>
      <details class="download-menu">
        <summary>
          <span data-download-menu-label>选择安装包</span>
          <span class="download-chevron" aria-hidden="true"></span>
        </summary>
        <div class="download-options">
          {platforms.map((p) => {
            const release = downloads[p.target];
            return (
              <a
                class="download-card"
                data-download={p.target}
                href={release?.url}
                aria-disabled={release ? undefined : 'true'}
                aria-label={
                  release
                    ? `下载 ${p.name} ${p.arch} v${release.version}`
                    : `${p.name} ${p.arch} 稳定通道暂不可用`
                }
              >
                <span class="os-icon" aria-hidden="true">
                  {p.symbol}
                </span>
                <div>
                  <strong>
                    下载 {p.name} <span>· {p.arch}</span>
                  </strong>
                  <small data-download-meta>
                    {release
                      ? `v${release.version} · ${Math.round(release.size / 1024 / 1024)} MB`
                      : '稳定通道暂不可用'}
                  </small>
                </div>
                <span class="download-arrow" aria-hidden="true">
                  {release ? '↓' : '—'}
                </span>
              </a>
            );
          })}
        </div>
      </details>
      <p
        class="download-status"
        data-download-status
        role="status"
        aria-live="polite"
      ></p>
    </div>
  </div>
</section>
<script>
  import { getRecommendedDownload } from '../data/download-platform';

  const cards = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-download]'),
  );
  const status = document.querySelector<HTMLElement>('[data-download-status]');
  const recommendation = document.querySelector<HTMLElement>(
    '[data-download-recommendation]',
  );
  const menuLabel = document.querySelector<HTMLElement>(
    '[data-download-menu-label]',
  );
  const menu = document.querySelector<HTMLDetailsElement>('.download-menu');
  document.addEventListener('click', (event) => {
    if (menu && event.target instanceof Node && !menu.contains(event.target))
      menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  const recommendedTarget = getRecommendedDownload().then((target) =>
    cards.find((card) => card.dataset.download === target),
  );

  async function showRecommendation() {
    const card = await recommendedTarget;
    if (!card?.hasAttribute('href') || !recommendation || !menuLabel) return;
    if (card.parentElement === recommendation) return;

    const hadFocus = document.activeElement === card;
    recommendation.append(card);
    recommendation.hidden = false;
    menuLabel.textContent = '其他安装包';
    if (hadFocus) card.focus();
  }

  void showRecommendation();
  let failures = 0;
  await Promise.all(
    cards.map(async (card) => {
      const [platform, arch] = card.dataset.download!.split('-');
      try {
        const response = await fetch(
          `https://updater.sxlw.ltd/v1/update/${platform}/${arch}?version=0.0.0&channel=stable`,
          { signal: AbortSignal.timeout(8000) },
        );
        if (!response.ok) throw new Error('Release unavailable');
        const data = await response.json();
        if (typeof data.signedManifest !== 'string')
          throw new Error('Invalid response');
        const bytes = Uint8Array.from(atob(data.signedManifest), (c) =>
          c.charCodeAt(0),
        );
        const manifest = JSON.parse(new TextDecoder().decode(bytes));
        const artifact = manifest.artifacts?.[card.dataset.download!];
        const url = new URL(artifact?.url);
        if (
          url.protocol !== 'https:' ||
          url.hostname !== 'releases.sxlw.ltd' ||
          url.username ||
          url.password ||
          !/^\d+\.\d+\.\d+$/.test(data.version) ||
          manifest.version !== data.version ||
          manifest.platform !== platform ||
          manifest.channel !== 'stable' ||
          !Number.isSafeInteger(artifact.size) ||
          artifact.size <= 0
        )
          throw new Error('Invalid release metadata');
        card.href = url.href;
        card.removeAttribute('aria-disabled');
        const name = card.querySelector('strong')!.textContent;
        card.setAttribute(
          'aria-label',
          `${name?.replace(/\s+/g, ' ').trim()} v${data.version}`,
        );
        card.querySelector('[data-download-meta]')!.textContent =
          `v${data.version} · ${Math.round(artifact.size / 1024 / 1024)} MB`;
        card.querySelector('.download-arrow')!.textContent = '↓';
        void showRecommendation();
      } catch {
        failures++;
      }
    }),
  );
  const unavailable = cards.some(
    (card) => card.getAttribute('aria-disabled') === 'true',
  );
  if (status && unavailable)
    status.textContent = '部分平台的稳定通道暂不可用，请稍后再试。';
  else if (status && failures)
    status.textContent = '暂时无法刷新版本，已保留最近核实的下载链接。';
</script>
