---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="shell footer-main">
    <a class="brand" href="#top" aria-label="Looper 首页">
      <img src={`${base}/logo-mark.svg`} width="32" height="32" alt="" />
      <span>Looper</span>
    </a>
    <p>让想法前进一步。</p>
    <nav aria-label="页脚导航">
      <a href="#features">产品</a>
      <a href="#changelog">更新</a>
      <a href="#faq">常见问题</a>
      <a href="#download">下载 ↗</a>
    </nav>
  </div>
</footer>

<a class="back-to-top" href="#top" aria-label="回到顶部" title="回到顶部">
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="m6 12 6-6 6 6M12 6v13"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</a>

<script>
  const backToTop = document.querySelector<HTMLAnchorElement>('.back-to-top');
  const updateBackToTop = () => {
    if (backToTop) backToTop.hidden = window.scrollY < 400;
  };
  updateBackToTop();
  window.addEventListener('scroll', updateBackToTop, { passive: true });
</script>
