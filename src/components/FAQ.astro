---
// FAQ 手风琴
const faqs = [
  {
    q: 'Looper 是聊天工具，还是工作流工具？',
    a: '两者结合使用。你可以在对话中说明目标，也可以把任务沉淀为工作流；画布负责组织节点与依赖，运行记录负责保留过程与结果。',
  },
  {
    q: '数据会上传到云端吗？',
    a: 'Looper 的工作流、运行记录和项目上下文由本机管理。使用云端模型或联网工具时，相关请求会发送给你选择的服务商或目标服务；请按自己的数据要求配置服务与权限。',
  },
  {
    q: '和直接使用 AI 编程助手有什么区别？',
    a: '一次对话适合即时协作；Looper 更适合把多步、可重复的任务组织起来。它提供工作流画布、技能管理、运行看板和权限模式，让执行过程更容易检查与复用。',
  },
  {
    q: '工作流是什么样的？',
    a: '一条工作流由节点、连线、变量与触发配置组成。你可以在画布中编辑它，保存到工作流库，也可以通过导入导出在不同环境之间迁移。',
  },
  {
    q: '支持哪些系统？',
    a: '当前提供 macOS（Apple Silicon 与 Intel）和 Windows x64 构建。Linux 版本仍在规划中。',
  },
  {
    q: 'Skill 怎么添加？',
    a: '在「技能」页创建、编辑或安装 Skill；它们会由 Looper 的本地技能目录管理，并可在工作流节点中引用。',
  },
];
---

<section id="faq" class="relative py-32 px-4">
  <div class="mx-auto max-w-3xl">
    <div class="text-center mb-16">
      <p class="section-eyebrow reveal">常见问题</p>
      <h2 class="reveal text-4xl md:text-5xl font-bold tracking-tight text-gradient">
        你可能会问
      </h2>
    </div>

    <div class="stagger space-y-3">
      {faqs.map((f) => (
        <details class="faq-item group glass hover:border-white/20 transition-colors" data-faq-item>
          <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none" aria-expanded="false">
            <span class="font-medium text-white/90 group-hover:text-white transition-colors">
              {f.q}
            </span>
            <span class="faq-toggle" aria-hidden="true">
              <span class="faq-toggle-label faq-toggle-label-expand">展开</span>
              <span class="faq-toggle-label faq-toggle-label-collapse">收起</span>
            </span>
          </summary>
          <div class="faq-answer">
            <div class="px-6 pb-5 -mt-1 text-white/60 leading-relaxed text-sm">
              {f.a}
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]').forEach((item) => {
    const summary = item.querySelector<HTMLElement>('summary');
    if (!summary) return;

    let animation: Animation | undefined;

    summary.addEventListener('click', (event) => {
      event.preventDefault();
      if (animation) return;

      const isOpening = !item.open;
      summary.setAttribute('aria-expanded', String(isOpening));

      if (reduceMotion) {
        item.open = isOpening;
        return;
      }

      const startHeight = item.offsetHeight;
      if (isOpening) item.open = true;
      const endHeight = isOpening ? item.scrollHeight : summary.offsetHeight;

      item.style.overflow = 'hidden';
      animation = item.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 320, easing: 'cubic-bezier(.22, 1, .36, 1)' },
      );

      animation.onfinish = () => {
        if (!isOpening) item.open = false;
        item.style.height = '';
        item.style.overflow = '';
        animation = undefined;
      };
    });
  });
</script>
