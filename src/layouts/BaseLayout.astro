---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Looper — 把 AI 任务跑成看得见的流程',
  description = 'Looper 是本地运行的 AI 工作流桌面应用：在对话中说明目标，用可编辑流程组织执行，并在关键操作前保持控制。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050510" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="black-theme min-h-screen">

    <slot />

    <script>
      import Lenis from 'lenis';

      // 平滑滚动：只在桌面端接管滚轮，触屏设备保留系统原生滚动手感。
      // 原生 smooth 与 Lenis 同时接管锚点会产生明显的“二次缓动”，所以由 Lenis 统一处理。
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const useSmoothScroll = finePointer.matches && !reduceMotion.matches;
      if (useSmoothScroll) {
        new Lenis({
            // 使用固定插值让连续滚轮输入更均匀，并交由 Lenis 管理动画帧。
            lerp: 0.085,
            smoothWheel: true,
            wheelMultiplier: 0.82,
            anchors: true,
            autoRaf: true,
        });
      }

      // 滚动进入观察器 —— reveal / reveal-scale / stagger 通用
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -80px 0px' },
      );

      document.querySelectorAll('.reveal, .reveal-scale, .stagger').forEach((el) => {
        observer.observe(el);
      });

    </script>
  </body>
</html>
