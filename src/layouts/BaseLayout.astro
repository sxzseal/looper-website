---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Looper — AI 驱动的工作流编排桌面应用',
  description = '一句自然语言,让 loop agent 通过本地 Claude Code 跑完整条多步流水线。DAG 一等公民、本地运行时、零 API Key。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#050510" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- 字体 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body class="relative min-h-screen">
    <!-- 全局背景装饰:大光晕 + 网格 -->
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="glow-orb w-[600px] h-[600px] bg-aurora-violet/20 -top-40 -left-40 animate-float-slow"></div>
      <div class="glow-orb w-[500px] h-[500px] bg-aurora-cyan/15 top-1/3 -right-40 animate-float-med"></div>
      <div class="glow-orb w-[700px] h-[700px] bg-aurora-pink/10 bottom-0 left-1/4 animate-float-slow"></div>
      <div class="absolute inset-0 bg-grid opacity-40 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_80%)]"></div>
    </div>

    <!-- 鼠标跟随光斑 -->
    <div
      id="cursor-glow"
      class="fixed w-[500px] h-[500px] rounded-full pointer-events-none -z-10 opacity-0 transition-opacity duration-500"
      style="background: radial-gradient(circle, rgba(124,92,255,0.15) 0%, transparent 60%); transform: translate(-50%, -50%);"
    >
    </div>

    <slot />

    <script>
      import Lenis from 'lenis';

      // 平滑滚动
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true,
      });

      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);

      // 滚动进入观察器 —— reveal / reveal-scale / stagger 通用
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -80px 0px' },
      );

      document.querySelectorAll('.reveal, .reveal-scale, .stagger').forEach((el) => {
        observer.observe(el);
      });

      // 鼠标跟随光斑
      const cursor = document.getElementById('cursor-glow');
      if (cursor && window.matchMedia('(hover: hover)').matches) {
        let mouseX = 0,
          mouseY = 0;
        let currentX = 0,
          currentY = 0;

        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          cursor.style.opacity = '1';
        });

        document.addEventListener('mouseleave', () => {
          cursor.style.opacity = '0';
        });

        function animateCursor() {
          currentX += (mouseX - currentX) * 0.1;
          currentY += (mouseY - currentY) * 0.1;
          if (cursor) {
            cursor.style.left = `${currentX}px`;
            cursor.style.top = `${currentY}px`;
          }
          requestAnimationFrame(animateCursor);
        }
        animateCursor();
      }

      // 视差:让带 data-parallax 的元素随滚动位移
      const parallaxItems = document.querySelectorAll<HTMLElement>('[data-parallax]');
      if (parallaxItems.length > 0) {
        lenis.on('scroll', ({ scroll }: { scroll: number }) => {
          parallaxItems.forEach((el) => {
            const speed = parseFloat(el.dataset.parallax || '0.3');
            el.style.transform = `translateY(${scroll * speed * -0.15}px)`;
          });
        });
      }
    </script>
  </body>
</html>
